# Core
APP_ENV=production
HTTP_PORT=8080
DATABASE_PATH=/data/flight_bot.db
TIMEZONE=Asia/Seoul

# Search / notification cadence
SEARCH_INTERVAL_HOURS=2
DAILY_SUMMARY_HOUR=8

# Slot policy
SLOT_ACTIVE_LIMIT=10

# Naver Flights SSE API
NAVER_API_URL=https://flight-api.naver.com/flight/international/searchFlights
NAVER_API_TIMEOUT_SECONDS=30
NAVER_API_ATTEMPTS=3
NAVER_MIN_REQUEST_INTERVAL_SECONDS=3

# Alert policy
# Current search shape: adult 1 / economy / direct / round trip.
ALERT_NONSTOP_ONLY=true
# Show cheapest unique round-trip combinations, up to TOP 5 by default.
ALERT_MAX_OFFERS=5
# API-displayed round-trip fare can trigger alerts; checkout verification is out of scope.
REQUIRE_VERIFIED_ALERTS=false

# Telegram
# In APP_ENV=production a token without an allowlist is rejected at startup.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_CHANNEL_IDS=

# Kakao Skill webhook (reactive only)
KAKAO_SKILL_SECRET=
KAKAO_ALLOWED_USER_IDS=

# Admin/test API secret
ADMIN_SECRET=
