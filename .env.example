# Core
APP_ENV=production
HTTP_PORT=8080
DATABASE_PATH=/data/flight_bot.db
TIMEZONE=Asia/Seoul

# Search / notification cadence
# Google Flights price observation every 2 hours.
SEARCH_INTERVAL_HOURS=2
# One of the scheduled searches also sends the regular daily price summary.
# With the default 2-hour cadence, use an even hour such as 8.
DAILY_SUMMARY_HOUR=8

# Slot policy
# Slots 1..10 are available. You may lower this per deployment, but never
# raise it above 10.
SLOT_ACTIVE_LIMIT=10

# Google Flights / Chromium
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=45000
BROWSER_BLOCK_ASSETS=true
# Kept only for compatibility with old deployments. Runtime price searches
# intentionally use a fresh isolated browser context each time, so cookies,
# cache and site storage are not carried between 2-hour observations.
BROWSER_PROFILE_DIR=
# Leave blank in normal operation. Use /debug when troubleshooting.
BROWSER_DEBUG_DIR=
GOOGLE_LANGUAGE=en
GOOGLE_CURRENCY=KRW
GOOGLE_GL=kr

# Alert policy
# Alerts use the round-trip prices visibly shown on Google Flights.
# Connections/stops are excluded by default.
ALERT_NONSTOP_ONLY=true
# Maximum number of ranked direct offers shown in one message. If fewer direct
# flights exist, only the available rows are shown.
ALERT_MAX_OFFERS=4
# false: Google Flights displayed round-trip price can trigger an alert.
REQUIRE_VERIFIED_ALERTS=false

# Target alert behavior
# A slot sends "target reached" only once per target setting. Price movement
# does not automatically re-arm it. /flight target ... explicitly re-arms once.

# Telegram
# In APP_ENV=production a token without an allowlist is rejected at startup.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_CHANNEL_IDS=

# Kakao Skill webhook (reactive only; proactive push needs BizMessage/AlimTalk later)
KAKAO_SKILL_SECRET=
KAKAO_ALLOWED_USER_IDS=

# Admin/test API. Keep this secret separate from Kakao.
# Available on the loopback-bound HTTP port in the default Docker compose:
#   POST /admin/check-all
#   POST /admin/daily-summary
#   POST /admin/check-slot/{slot_id}
#   POST /admin/daily-summary/{slot_id}
ADMIN_SECRET=
