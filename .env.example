# Core
APP_ENV=production
HTTP_PORT=8080
DATABASE_PATH=/data/flight_bot.db
TIMEZONE=Asia/Seoul
CHECK_HOURS=8,20

# Google Flights / Chromium
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=45000
BROWSER_BLOCK_ASSETS=true
# Persistent runtime profile avoids launching a completely fresh Google session
# for every slot. Leave blank only for ephemeral/dev runs.
BROWSER_PROFILE_DIR=/data/browser-profile
# Leave blank in normal operation. Use /debug when troubleshooting.
BROWSER_DEBUG_DIR=
GOOGLE_LANGUAGE=en
GOOGLE_CURRENCY=KRW
GOOGLE_GL=kr
# true: threshold alert requires an externally verified seller-checkout final total.
# The current legacy runtime Google provider is intentionally unverified/fail-closed.
REQUIRE_VERIFIED_ALERTS=true

# Telegram
# In APP_ENV=production a token without an allowlist is rejected at startup.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Discord
# In APP_ENV=production a token without an allowlist is rejected at startup.
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_CHANNEL_IDS=

# Kakao Skill webhook (reactive only; proactive push needs BizMessage/AlimTalk later)
# The endpoint returns 404 when KAKAO_SKILL_SECRET is blank.
KAKAO_SKILL_SECRET=
KAKAO_ALLOWED_USER_IDS=

# Admin API (/admin/check-all). Separate from the Kakao secret.
# The endpoint returns 404 when ADMIN_SECRET is blank.
ADMIN_SECRET=
