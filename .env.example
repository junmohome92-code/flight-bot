# Core
APP_ENV=production
HTTP_PORT=8080
DATABASE_PATH=/data/flight_bot.db
TIMEZONE=Asia/Seoul
CHECK_HOURS=8,20
MAX_SLOTS=3
CACHE_MINUTES=20

# Flight provider
# Multiple keys: comma-separated. Requests rotate round-robin in this order.
# Example: SERPAPI_API_KEYS=key1,key2,key3
SERPAPI_API_KEYS=
# Legacy single-key fallback (optional). Prefer SERPAPI_API_KEYS.
SERPAPI_API_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search.json

# Optional AI parser (leave blank to disable)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ALLOWED_CHANNEL_IDS=

# Kakao Skill webhook
KAKAO_SKILL_SECRET=
KAKAO_ALLOWED_USER_IDS=
